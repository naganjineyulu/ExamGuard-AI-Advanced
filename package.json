{
  "name": "examguard-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npx -y -p node@22 vite --host 0.0.0.0",
    "dev:server": "npx -y -p node@22 node --env-file-if-exists=.env server/index.js",
    "build": "npx -y -p node@22 vite build",
    "start": "npx -y -p node@22 node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  }
}
