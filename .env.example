VITE_API_URL=http://localhost:5050
PORT=5050
APP_BASE_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Configure these values with a verified Cloudflare Email Sending domain
# before using email verification outside local development.
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
EMAIL_FROM=verify@your-verified-sending-domain.example
